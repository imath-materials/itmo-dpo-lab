        "jsCode": "const j=$input.first().json;const topic=String(j['Тема']||'').trim().slice(0,120);const description=String(j['Описание']||'').trim().slice(0,2000);const priority=String(j['Приоритет']||'Обычный');return [{json:{topic,description,priority,valid:topic.length>3&&description.length>10,checked_by_human:false}}];"
      },
